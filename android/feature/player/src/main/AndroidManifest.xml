<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 재생 중 Media3 가 띄우는 미디어 알림용 Foreground Service (설계 §4.1 재생) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application>
        <!--
            MediaLibraryService: 앱 화면 외에 AAOS 시스템 미디어 UI 가 노래 목록을 탐색·재생할 수 있게
            MediaBrowserService 액션도 연다 (설계 §4.1 [확인 필요], §13-5).
            [확인 필요] Pleos Connect 미디어 센터가 이 서비스를 실제로 찾는지는 에뮬레이터에서 확인.
        -->
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>
</manifest>
