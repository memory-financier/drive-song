<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 가족 목소리 클립 녹음 (설계 §8). [확인 필요] 설계 §13-3: 서드파티 앱의 차량 마이크 사용 가능 여부 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Pleos SpeechToText SDK "말로 하기" (설계 §8.2). 없으면 initialize 가 SecurityException (에뮬레이터 확인) -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <application>
        <!--
            Gleo Interface (설계 §8.2): assets/schema.json 의 function 이름이 곧 action.
            export 필수 (Gleo 가 보낸다). 녹음은 등록·동의한 구성원만, 5초, 신호음 + 홈 상태 표시.
        -->
        <receiver
            android:name=".gleo.GleoActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="PLAY_DRIVE_SONG" />
                <action android:name="RECORD_FAMILY_VOICE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
