# 클립 파일과 기본 SQLite DB 위치 (Docker에서는 /data 로 고정)
DATA_DIR=data
# 비워두면 DATA_DIR/drive_song.db 사용
# DATABASE_URL=sqlite:///data/drive_song.db

# 음악 생성 공급자: fake(기본, 키 불필요) | minimax | acestep (FAL_KEY) | mureka (MUREKA_API_KEY)
#                   | acestep_local (로컬 ACE-Step 1.5 API 서버, 키 불필요)
MUSIC_PROVIDER=fake
# acestep_local: ACE-Step 서버 주소, thinking(곡 구성 계획, 느려짐), 추론 스텝
# ACESTEP_LOCAL_URL=http://127.0.0.1:8001
# ACESTEP_LOCAL_THINKING=false
# ACESTEP_LOCAL_STEPS=8
# FAL_KEY=
# MUREKA_API_KEY=
# 공급자 폴링 간격 / 제출 후 생성 제한 시간(초)
# JOB_POLL_INTERVAL_SEC=5
# JOB_TIMEOUT_SEC=300
# fake 공급자가 생성 중(pending)으로 머무는 시간(초)
# FAKE_MUSIC_DELAY_SEC=3

# 가사 LLM (/v1/lyrics, 대화 잡): fake(기본, 키 불필요) | claude (ANTHROPIC_API_KEY) | ollama (로컬, 키 불필요)
# 대화 잡의 대화는 외부 LLM(claude)에 보내지 않는다 (설계 §8.3)
LLM_PROVIDER=fake
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma3:12b
# 대화 분석·목소리 변환 (설계 §7.5): fake(기본, GPU 불필요) | voicelab (같은 PC 의 ../voice-lab 서비스)
VOICE_PROVIDER=fake
# VOICELAB_URL=http://127.0.0.1:8002
# 지명·날씨 (/v1/trips/enrich): fake(기본) | live
# live: KAKAO_REST_API_KEY 가 있으면 Kakao 역지오코딩, 없으면 OSM Nominatim(초당 1건). 날씨는 Open-Meteo(키 불필요)
GEO_PROVIDER=fake
# KAKAO_REST_API_KEY=
# Nominatim 사용 정책: 앱 식별 User-Agent. 운영 시 연락처(URL 또는 이메일)를 넣는다
# NOMINATIM_USER_AGENT=DriveSong-server/0.1 (Pleos Playground contest app)
